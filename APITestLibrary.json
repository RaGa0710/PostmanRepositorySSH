    {
      "name": "FilterBooks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\n// 1. Status code is 200\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// 2. Response is JSON (Content-Type header contains application/json)\npm.test(\"Response is JSON\", function () {\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\n});\n\n// 3. Response body is an array\npm.test(\"Response body is an array\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData).to.be.an(\"array\");\n});\n\n// 4-8. Per-item validations\npm.test(\"Each book has required fields and correct types\", function () {\n    const books = pm.response.json();\n    books.forEach(function (book) {\n        // 4. Each book has required fields\n        pm.expect(book).to.have.all.keys(\"id\", \"title\", \"author\", \"genre\", \"yearPublished\", \"checkedOut\", \"isPermanentCollection\", \"createdAt\");\n\n        // 5. Each book's id is a non-empty string\n        pm.expect(book.id).to.be.a(\"string\").and.to.have.length.above(0);\n\n        // 6. Each book's title is a non-empty string\n        pm.expect(book.title).to.be.a(\"string\").and.to.have.length.above(0);\n\n        // 7. Each book's yearPublished is a number\n        pm.expect(book.yearPublished).to.be.a(\"number\");\n\n        // 8. Each book's checkedOut is a boolean\n        pm.expect(book.checkedOut).to.be.a(\"boolean\");\n    });\n});\n\n// 9. Response time is under 2000ms\npm.test(\"Response time is under 2000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(2000);\n});\n"
            ]
          }
        }
      ],
